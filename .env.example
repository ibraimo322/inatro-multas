#--------------------------------------------------------------------
# INATRO — Exemplo de Configuração de Ambiente (.env.example)
# Copie este ficheiro para ".env" e personalize para o seu ambiente local:
#   copy .env.example .env
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT (development / production / testing)
#--------------------------------------------------------------------
CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------
app.baseURL = 'http://localhost:8081/'
app.forceGlobalSecureRequests = false

#--------------------------------------------------------------------
# DATABASE (SQLite3 pré-configurado por padrão)
#--------------------------------------------------------------------
database.default.DBDriver = SQLite3
# database.default.database = 'writable/database/inatro_database.db'
database.default.DBPrefix = ''

#--------------------------------------------------------------------
# SECURITY & CSRF
#--------------------------------------------------------------------
security.csrfProtection = 'cookie'
security.tokenRandomize = true
security.tokenName = 'csrf_token'
security.headerName = 'X-CSRF-TOKEN'
security.cookieName = 'csrf_cookie'
security.expires = 7200
security.regenerate = true
security.redirect = true
